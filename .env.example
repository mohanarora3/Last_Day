# FalkorDB connection (defaults shown)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_PASSWORD=

# Needed only for GitHub ingestion and backtests (a read-only token is enough)
GITHUB_TOKEN=

# Optional: Slack and Notion. You can paste these in the Connections panel instead.
# The Slack token is only needed for the live option; uploading a Slack export needs no token.
# SLACK_BOT_TOKEN=
# NOTION_TOKEN=

# Optional LLM. Without one, answers are extractive and still cited.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1   # any OpenAI-compatible API
# LLM_MODEL=

PORT=8000
